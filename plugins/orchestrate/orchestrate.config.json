{
  "$schema": "./orchestrate.config.schema.json",
  "autonomy": "propose",
  "harness": "auto",
  "threshold": {
    "maxParallelAuto": 3,
    "maxFilesAuto": 5
  },
  "roles": {
    "orchestrator": "auto",
    "senior": "auto",
    "builder": "auto",
    "scout": "auto"
  },
  "harnessProfiles": {
    "claude": {
      "roles": { "orchestrator": "opus", "builder": "sonnet", "scout": "haiku" }
    },
    "codex": {
      "roles": { "orchestrator": "gpt-5.6-sol", "builder": "gpt-5.6-terra", "scout": "gpt-5.6-luna" }
    }
  },
  "workflows": {
    "research":  { "enabled": true,  "maxParallel": 4 },
    "design":    { "enabled": true,  "maxParallel": 3 },
    "implement": { "enabled": true,  "maxParallel": 3, "maxSenior": 1 },
    "debug":     { "enabled": true,  "maxParallel": 4 },
    "review":    { "enabled": true,  "maxParallel": 4 },
    "optimize":  { "enabled": false, "maxParallel": 3 }
  },
  "worktrees": {
    "mode": "auto",
    "cleanup": "on-success"
  },
  "escalation": {
    "scoutToBuilder": true,
    "builderToSenior": true
  },
  "doctrine": "standard",
  "alwaysPassModelExplicitly": true
}
